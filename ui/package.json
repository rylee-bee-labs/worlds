{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs && git diff --exit-code src/generated",
    "kit:build": "node scripts/build-kit.mjs",
    "kit:check": "node scripts/check-kit.mjs",
    "kit:stamp": "node scripts/stamp-kit.mjs",
    "kit:test:e2e": "playwright test -c playwright.kit.config.ts",
    "api:generate": "node scripts/generate-api-types.mjs",
    "dev": "npm run tokens:generate && vite",
    "build": "npm run tokens:generate && npm run icons:generate && npm run api:generate && tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "~7.0.2",
    "uat-harness": "github:Rylee-Bee/uat-harness",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
