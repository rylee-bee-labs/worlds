# Copy to .env and fill in. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PW_API_TOKEN=

# Web Push (native notifications). Both optional: with neither set,
# everything else works and push simply reports "not configured".
# Generate a VAPID key pair with:
#   personal-world push keygen
# Paste the printed private key block here (a real PEM body, or a
# base64url raw P-256 key — both are accepted). The app reads this and
# never writes it anywhere. See docs/NOTIFICATIONS.md.
PW_VAPID_PRIVATE_KEY=
# Who push services may contact about: mailto: you@example.com, or an
# https: URL for your site.
PW_VAPID_SUBJECT=
